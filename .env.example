# ============================================
# DRK Troisdorf Frühwarnsystem - Konfiguration
# ============================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# --- Authentifizierung ---
FWS_SECRET_KEY=HIER_SICHEREN_KEY_GENERIEREN
FWS_ADMIN_USERNAME=admin
FWS_ADMIN_PASSWORD=SICHERES_PASSWORT_HIER

# --- Telegram Bot ---
# Bot bei @BotFather erstellen, Token hier eintragen
FWS_TELEGRAM_BOT_TOKEN=
FWS_TELEGRAM_CHAT_ID=
FWS_TELEGRAM_GROUP_ID=

# --- Push Notifications (ntfy.sh) ---
FWS_NTFY_SERVER=https://ntfy.sh
FWS_NTFY_TOPIC=drk-troisdorf-fws

# --- SMS Fallback (Twilio) ---
FWS_TWILIO_ACCOUNT_SID=
FWS_TWILIO_AUTH_TOKEN=
FWS_TWILIO_FROM_NUMBER=
FWS_ALERT_PHONE_NUMBER=

# --- E-Mail ---
FWS_SMTP_HOST=
FWS_SMTP_PORT=587
FWS_SMTP_USER=
FWS_SMTP_PASSWORD=
FWS_ALERT_EMAIL=

# --- Ollama (Lokales LLM) ---
FWS_OLLAMA_URL=http://ollama:11434
FWS_OLLAMA_MODEL=llama3.2:3b

# --- MQTT / Home Assistant ---
FWS_MQTT_BROKER=mqtt
FWS_MQTT_PORT=1883
FWS_MQTT_USERNAME=
FWS_MQTT_PASSWORD=
FWS_HA_DISCOVERY_PREFIX=homeassistant

# --- Auto-Update ---
FWS_AUTO_UPDATE_ENABLED=true
FWS_AUTO_UPDATE_CHECK_INTERVAL_MINUTES=30
FWS_AUTO_UPDATE_BRANCH=main

# --- Standort ---
FWS_CENTER_LAT=50.8159
FWS_CENTER_LON=7.1533
FWS_DEFAULT_RADIUS_KM=30
FWS_CITY_NAME=Troisdorf
FWS_REGION=Rhein-Sieg-Kreis

# --- DWD ---
FWS_DWD_STATION_ID=10513

# --- Datenbank (normalerweise nicht ändern) ---
FWS_DATABASE_URL=postgresql+asyncpg://fws:fws_secret@db:5432/fruewarnsystem
FWS_REDIS_URL=redis://redis:6379/0

# --- App-Anbindung ---
FWS_PUBLIC_URL=https://riegel-troisdorf.de/fruelage

# --- Soziale Netze ---
# Der früheste Kanal, den das System hat. Mastodon und Telegram laufen ohne
# alles. Die übrigen Netze haben ihre offenen Schnittstellen geschlossen und
# verlangen Geld, ein Geschäftskonto oder eine Prüfung durch den Betreiber.
#
# Jeder Abruf ist fertig gebaut und schaltet sich selbst zu, sobald die
# Zugangsdaten hier stehen. Ohne sie bleibt das jeweilige Netz still — das
# ist kein Fehler, aber auch keine Entwarnung. Was gerade mithört, steht
# unter /api/dashboard/social/platforms.

# Telegram: öffentliche Kanäle, kommagetrennt, ohne @. Es gibt keine Suche,
# Kanäle müssen namentlich bekannt sein. Deutsche Behörden nutzen Telegram
# kaum; voreingestellt ist deshalb nur die tagesschau.
FWS_TELEGRAM_KANAELE=tagesschau

# Bluesky: App-Passwort verwenden, NIE das Kontopasswort.
# Anlegen unter Einstellungen → Datenschutz und Sicherheit → App-Passwörter.
FWS_BLUESKY_HANDLE=
FWS_BLUESKY_APP_PASSWORD=

# X (Twitter): App-only Bearer Token aus dem Entwicklerportal.
# ACHTUNG: X rechnet seit Februar 2026 je gelesenem Beitrag ab
# (Größenordnung 0,005 USD). Kein Token = keine Kosten.
FWS_X_BEARER_TOKEN=

# Meta — Facebook und Instagram teilen sich einen Zugang.
# Langlebiges Zugriffstoken der App (developers.facebook.com).
FWS_META_ACCESS_TOKEN=
# Facebook-Seiten, kommagetrennt (Kennung oder Name aus der Adresse).
# Eigene Seiten gehen sofort. Für FREMDE Seiten — Feuerwehr, Stadt, Polizei —
# braucht die App die Freigabe "Page Public Content Access": Antrag bei Meta
# mit Unternehmensnachweis, mehrere Wochen Bearbeitung.
FWS_FACEBOOK_SEITEN=
# Instagram: Kennung des Geschäftskontos, über das gesucht wird. Das Konto
# muss ein Business- oder Creator-Konto sein und mit einer Facebook-Seite
# verbunden. Harte Grenze: 30 verschiedene Hashtags je Woche.
FWS_INSTAGRAM_BUSINESS_ID=

# TikTok Research API: Zugangsdaten aus dem bewilligten Forschungsantrag.
# Zugang nur für Forschungseinrichtungen und gemeinnützige Organisationen
# mit öffentlichem Zweck (developers.tiktok.com/products/research-api).
FWS_TIKTOK_CLIENT_KEY=
FWS_TIKTOK_CLIENT_SECRET=
